# RK3568_PTZ_Qt 板端运行配置（由 Bash 脚本 source）
DESKTOP_USER=linaro
DISPLAY_ID=:0
XAUTHORITY_FILE=/home/linaro/.Xauthority

DSI_OUTPUT=DSI-1
DSI_MODE=720x1280
DSI_ROTATE=right
DSI_POSITION=0x0

HDMI_OUTPUT=HDMI-1
HDMI_MODE=1920x1080
HDMI_RATE=60
HDMI_POSITION=1280x0

TOUCH_DEVICE=goodix-ts
QT_PLATFORM=xcb

# PCIe 驱动随发布包部署到 APP_ROOT/driver。
PCIE_DRIVER_MODULE=pango_pci_driver
PCIE_DRIVER_DEVICE=/dev/pango_pci_driver
PCIE_DRIVER_FILE=pango_pci_driver.ko

# 本版本默认验证 v2.9.1 候选车牌模型。legacy 使用 models/ 根目录；
# 其他 profile 使用 models/<profile>/。可在启动命令前临时覆盖。
NPU_MODEL_PROFILE=${NPU_MODEL_PROFILE:-v291_candidate}

# stable：沿用现有 OCR 缓存/轨迹/EMA/投票；raw：逐帧结果直出，
# 用于把模型与逐帧后处理效果和时序稳帧影响分开测量。
PLATE_POSTPROCESS_MODE=${PLATE_POSTPROCESS_MODE:-stable}

# auto：使用带宽度对齐保护和自检的 RGA 路径，失败自动回退 CPU；
# cpu：强制 CPU 预处理，用于板端隔离 RGA/BSP 兼容性问题。
V291_PREPROCESS_MODE=${V291_PREPROCESS_MODE:-auto}
