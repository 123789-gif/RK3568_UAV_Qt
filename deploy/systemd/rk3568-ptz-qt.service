[Unit]
Description=RK3568 PTZ Qt Application
After=lightdm.service graphical.target
Wants=lightdm.service

[Service]
Type=forking
User=root
WorkingDirectory=/userdata/Apps/RK3568_PTZ_Qt
ExecStart=/userdata/Apps/RK3568_PTZ_Qt/scripts/start.sh
ExecStop=/userdata/Apps/RK3568_PTZ_Qt/scripts/stop.sh
PIDFile=/userdata/Apps/RK3568_PTZ_Qt/run/rk_dual_screen_video.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
